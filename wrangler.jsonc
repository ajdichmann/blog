{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aj-dichmann-blog",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.ajdichmann.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-db",
      "database_id": "5438b3eb-5f76-4795-b94c-b875b3895dfd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "7553f2a7a65c4a259ae458a66e314d8b"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
