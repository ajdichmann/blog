---
import CmsPage from "@/components/CmsPage.astro";
import featuredImage from "@/assets/magento-development.png";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Houston Magento Development Agency",
  provider: {
    "@type": "LocalBusiness",
    name: "AJ Dichmann",
    areaServed: "Texas",
