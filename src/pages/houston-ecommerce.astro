---
import CmsPage from "@/components/CmsPage.astro";
import featuredImage from "@/assets/shopify-orange.png";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Houston Ecommerce Design & Development Agency",
  provider: {
    "@type": "LocalBusiness",
    name: "AJ Dichmann",
