---
import { useTranslations } from "@/i18n";
import RootLayout from "@/layouts/RootLayout.astro";
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import InteriorPageTitle from "@/components/InteriorPageTitle.astro";

const t = useTranslations();

---
<style>
  p {
    padding-bottom: 0.5em
  }
  h2 {
    font-size: 1.5rem /* 24px */;
    line-height: 2rem /* 32px */;
    font-weight: 700;
    letter-spacing: -0.025em;
      }
</style>

<RootLayout
  title="About This Site | AJ Dichmann"
  description="Get started with one of the top rated GTM teams!"
>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="pb-8 pt-6 md:space-y-5 text-gray-900 dark:text-gray-100">

      <Breadcrumbs text="About This Site" />

      <InteriorPageTitle
        title="About This"
        highlight="Site"
      />

      <p class="font-bold">Want to know more about this site?</p>
      <p>This website is build with:</p>
      <ul>
        <li>Astro.js</li>
        <li>Tailwinds</li>
        <li>Cloudflare</li>
        <li>Partytown</li>
      </ul>
    </div>
  </div>
</RootLayout>