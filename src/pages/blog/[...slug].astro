---
import PostLayout from "@/layouts/PostLayout.astro";
import SimpleLayout from "@/layouts/SimplePostLayout.astro";
import { decodeSlug } from "emdash";
import { getPostBySlug, getPostNeighbors } from "@/lib/emdash";

export const prerender = false;

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return Astro.redirect("/404");
}

const [{ post, cacheHint }, { next, prev }] = await Promise.all([
  getPostBySlug(slug),
  getPostNeighbors(slug),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

if (!post) {
  return Astro.redirect("/404");
}

const postLayout = post.data.post_layout;
---

{postLayout === 'simple' ? <SimpleLayout {post} {next} {prev} /> : <PostLayout {post} {next} {prev} />}
