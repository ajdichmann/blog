---
import RootLayout from '../layouts/RootLayout.astro';
import { getPage } from "@/lib/emdash";

const { page, cacheHint } = await getPage("schedule");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<RootLayout title={page.seoTitle} description={page.seoDescription}>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6" {...page.edit.title}>{page.title}</h1>
    <div class="calendly-inline-widget" data-url="https://calendly.com/aj-globerunner/60min" style="min-width:320px;height:100vh;overflow:hidden;"></div>
    <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
  </div>
</RootLayout> 