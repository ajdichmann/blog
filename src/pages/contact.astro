---
import RootLayout from "@/layouts/RootLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import InteriorPageTitle from "@/components/InteriorPageTitle.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact AJ Dichmann",
  "provider": {
    "@type": "LocalBusiness",
    "name": "AJ Dichmann",
    "areaServed": "Texas"
  }
};
---

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
    }
  }

  .calendly-wrapper {
    height: 700px;
    overflow: hidden;
  }

  .calendly-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    background-color: white;
    color: #1a202c;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  .dark .form-group input,
  .dark .form-group textarea {
    background-color: #1a202c;
    border-color: #4a5568;
    color: white;
  }

  button {
    padding: 0.75rem 1.5rem;
    background-color: #3b82f6;
    color: white;
    font-weight: 500;
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #2563eb;
  }
</style>

<RootLayout
  title="Contact AJ Dichmann | Schedule a Meeting or Send a Message"
  description="Get in touch with AJ Dichmann. Schedule a meeting through Calendly or send a message through our contact form."
>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="pb-8 pt-6 md:space-y-5">
      <Breadcrumbs text="Contact" />
      <InteriorPageTitle 
        title="Let's"
        highlight="Connect"
      />
      
      <div class="contact-container">
        <!-- Calendly inline widget -->
        <div class="calendly-wrapper">
          <iframe
            src="https://calendly.com/ajdichmann/30min"
            style="min-width: 320px;"
          ></iframe>
        </div>

        <!-- Contact Form -->
        <form class="contact-form" id="contactForm" onsubmit="handleSubmit(event)">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
          
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" />
          </div>
          
          <div class="form-group">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
            ></textarea>
          </div>
          
          <button type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</RootLayout>

<script>
  function handleSubmit(event) {
    event.preventDefault();
    const formData = new FormData(event.target as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());
    
    // Here you would typically send the data to your backend
    console.log('Form submitted:', data);
    
    // For now, just show an alert
    alert('Thanks for your message! We\'ll get back to you soon.');
    (event.target as HTMLFormElement).reset();
  }
</script> 