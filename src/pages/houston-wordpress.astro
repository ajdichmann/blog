---
import { useTranslations } from "@/i18n";
import RootLayout from "@/layouts/RootLayout.astro";
import ServicesHero from "@/components/ServicesHero.astro";
import featuredImage from "@/assets/wordpress-orange.png";
import OrangeAlert from "@/components/OrangeAlert.astro";
const t = useTranslations();

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Houston Wordpress Development & Consulting",
  provider: {
    "@type": "LocalBusiness",
    name: "AJ Dichmann",
    areaServed: "Texas",
  },
  serviceType: "Wordpress Development",
};
---

<RootLayout
  title="Houston Wordpress Design &Development Agency Service | AJ Dichmann"
  description="Get started with the top rated Wordpress experts in Houston for SEO and Web Development"
>
  <schema item={schema}></schema>
  <ServicesHero
    title="Houston Wordpress Development & Consulting"
    description="Get started with the top rated WordPress team in Houston. Our team has countless years of building, fixing and maintaining WordPress websites under our belt."
    blogLink={{
      text: "What's new in WordPress",
      url: "/tags/wordpress/",
    }}
    image={{
      src: featuredImage,
      alt: "Houston WordPress Development Services",
      width: 400,
      height: 534,
    }}
    breadcrumbsText="Houston Wordpress Agency"
  />

  <!-- Rest of the content -->
  <div class="divide-y divide-gray-200 dark:divide-gray-700 relative z-10">
    <div class="prose dark:prose-invert max-w-none relative z-10">
      <h1>Houston WordPress Development & Consulting</h1>
      <p>
        Looking for expert WordPress help in Houston? You're in the right place.
        Our seasoned development team has years of experience designing,
        building, and fixing WordPress websites for businesses across the
        Houston area.
      </p>
      <p>
        From theme customization to full website builds, we handle it all. If
        you need a reliable Houston WordPress developer who can move fast and
        deliver results, we're here to help.
      </p>

      <h2>Local Houston WordPress Experts</h2>
      <p>
        Struggling with a broken website or outdated design? Our Houston-based
        WordPress developers have been working with WordPress since the early
        2000s. We know what makes a site run efficiently, rank in search, and
        convert visitors into customers.
      </p>
      <p>
        Whether you need WordPress troubleshooting, performance optimization, or
        help migrating to a better host or theme—we've got you covered. Our
        commitment is to fast, friendly support and results that speak for
        themselves.
      </p>

      <h2>Custom WordPress Theme Design</h2>
      <p>
        Your business deserves a website that looks and performs like no one
        else's. We create modern, responsive WordPress themes using HTML5, CSS3,
        and JavaScript on the frontend, and robust PHP/MySQL on the backend.
      </p>
      <p>
        We also optimize every site for SEO to help you rank faster in Google
        search results. Using Gutenberg, Advanced Custom Fields, and Tailwind
        CSS, we deliver lightning-fast, mobile-first websites built for the
        Houston market.
      </p>

      <OrangeAlert
        title="Pro Tip"
        message="Regularly updating your WordPress core, themes, and plugins not only improves site security but can also boost performance and SEO. Always back up your site before making updates."
      />

      <h2>Custom WordPress Development</h2>
      <p>
        Not every business fits into a pre-made theme—and that's where we come
        in. Our Houston WordPress developers specialize in custom solutions
        tailored to your specific needs.
      </p>
      <p>
        Whether you need an interactive tool, dynamic content features, or a
        highly stylized layout, we'll bring your ideas to life with clean,
        SEO-friendly code.
      </p>

      <h2>WordPress Migrations</h2>
      <p>
        Need to move your existing website to WordPress? We handle migrations of
        all types—from simple brochure sites to large ecommerce platforms. No
        data loss, no broken links, no downtime.
      </p>
      <p>
        We'll make sure your content, SEO rankings, and functionality all
        transfer smoothly so your business keeps running without disruption.
      </p>

      <h2>WordPress Maintenance Plans & Updates</h2>
      <p>
        Keeping your WordPress site secure, fast, and up-to-date is critical for
        performance and peace of mind. Our <a
          href="/wordpress-maintenance-plans/"></a>monthly WP maintenance plans
      </p> cover everything from plugin and theme updates to regular security scans,
      backups, and performance monitoring.
    </div>
    <p>
      We proactively manage updates to prevent compatibility issues, monitor
      uptime, and handle any troubleshooting that comes up—so your site stays
      online and optimized. With our Houston-based team, you'll have local
      experts ready to step in whenever you need support.
    </p>

    <h2>Gutenberg & Page Builder Support</h2>
    <p>
      We're pros with Gutenberg, but we also work with popular WordPress page
      builders like Elementor, Divi, and Visual Composer. No matter what your
      site is built with, we can improve it or rebuild it entirely—your choice.
    </p>
    <p>
      If you want a lightning-fast custom block-based site, we recommend
      Gutenberg. But we're happy to work within your current system and make it
      better.
    </p>

    <h2>Theme Customization & Feature Additions</h2>
    <p>
      Already have a WordPress theme but want to upgrade it? We can help. From
      advanced forms and calculators to visual enhancements and backend
      controls—we'll add the functionality you need without compromising your
      current setup.
    </p>
    <p>
      Many Houston businesses have trusted us to transform their theme into a
      completely unique, conversion-focused website.
    </p>

    <h2>Let's Talk About Your WordPress Project</h2>
    <p>
      If you're ready to get more from your website, reach out today. We've
      helped Houston businesses grow from zero visibility to thousands of
      monthly site visitors—through smart WordPress development, custom design,
      and local SEO strategies that actually work.
    </p>
    <p>
      <strong>Call us at (972) 538-0260</strong> to discuss your Wordpress site.
    </p>
  </div>
</RootLayout>
