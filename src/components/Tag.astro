---
import Link from "./Link.astro";
import { getEntry } from "astro:content";
import type { CmsTag } from "@/lib/emdash";

interface Props {
  slug: string;
  tag?: CmsTag | { id?: string; slug?: string; data?: { name?: string } };
}

const { tag: providedTag, slug: propSlug } = Astro.props;
const legacyTag = providedTag ? undefined : await getEntry("tags", propSlug);
const tag = providedTag ?? legacyTag;
const slug = ("slug" in tag! && tag!.slug) || ("id" in tag! && tag!.id) || propSlug;
const name = "name" in tag! ? tag!.name : tag?.data?.name ?? slug;
---

<Link
  href={`/tags/${slug}/`}
  class:list={[
    "mr-3",
    "text-sm",
    "font-medium",
    "uppercase",
    "text-primary-500",
    "hover:text-primary-600",
    "dark:hover:text-primary-400"
  ]}
>
  {name}
</Link>
