---
import { PortableText } from "emdash/ui";
import OrangeAlert from "@/components/OrangeAlert.astro";
import { portableComponents } from "@/components/portable/components";
import { blockFieldEdit, blockPortableText, type OrangeAlertBlock } from "@/lib/emdash";

const { value, blockKey } = Astro.props as { value: OrangeAlertBlock; blockKey: string };
---

<OrangeAlert title={value.heading ?? ""} id={`alert-${blockKey}`} titleEdit={blockFieldEdit(value, "heading")}>
  <PortableText value={blockPortableText(value, "text")} components={portableComponents} />
</OrangeAlert>
