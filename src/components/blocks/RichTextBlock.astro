---
import { PortableText } from "emdash/ui";
import { portableComponents } from "@/components/portable/components";
import { blockPortableText, type RichTextBlock } from "@/lib/emdash";

const { value } = Astro.props as { value: RichTextBlock };
---

<PortableText value={blockPortableText(value, "content")} components={portableComponents} />
