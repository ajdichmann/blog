---
import { SITE_METADATA, NAVIGATION } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import MobileNav from "@/solid/MobileNav.tsx";
import ThemeSwitcher from "@/solid/ThemeSwitcher.tsx";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<header class="flex items-center justify-between py-10 z-50" role="banner">
  <div class="mr-3 md:w-40 w-20">
    <a href="/" class="inline-block" aria-label={t("siteMetadata.headerTitle")}>
      <Logo class="w-full" /> 
    </a>
  </div>
  <nav class="flex items-center leading-5 space-x-4 sm:space-x-6" aria-label={t("nav.main")}>
    <ul class="flex items-center space-x-4 sm:space-x-6">
      {
        NAVIGATION.filter((link) => link.href !== "/").map((link) => (
          <li>
            <HeaderLink
              href={link.href}
              class="hidden sm:block font-medium text-gray-900 dark:text-gray-100"
            >
              {t(link.title as keyof typeof t)}
            </HeaderLink>
          </li>
        ))
      }
    </ul>
    <div class="flex gap-4" aria-label={t("nav.actions")}>
      <!--<SearchButton />-->
      <ThemeSwitcher client:only="solid-js" />
      <MobileNav client:only="solid-js" />
    </div>
  </nav>
</header>
