---
import Announcement from './Announcement.astro';
import { SITE_METADATA } from '../consts';
import { getCollection } from "astro:content";
import { excludeDrafts, sortBlogPosts } from "@/functions";

// Add props for better component reusability
interface Props {
  title?: string;
  subtitle?: string;
  showAnnouncement?: boolean;
  calendly?: string;
  blogPost?: {
    title: string;
    url: string;
    ctatext: string;
  };
}

// Get the latest blog post
const latestPost = await getCollection("blog", excludeDrafts)
  .then(sortBlogPosts)
  .then(posts => posts[0]);

const { 
  title = "AJ Dichmann",
  subtitle = "Digital Marketing and SEO Consulting in Texas with Globe Runner",
  showAnnouncement = true,
  calendly = SITE_METADATA.calendly,
  blogPost = latestPost ? {
    title: "Read my newest blog post!",
    url: `/blog/${latestPost.slug}`,
    ctatext: "Read blog"
  } : undefined
} = Astro.props;
---

<section class="bg-white dark:bg-gray-900 dark:text-white relative" aria-label="Hero section">
    <div class="relative isolate px-6 pt-14 lg:px-8">
        <!-- Decorative background elements -->
        <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
            <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-primary-700 to-primary-300 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" />
        </div>
        
        <div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-24">
            {showAnnouncement && blogPost && 
                <Announcement 
                    blogTitle={blogPost.title}
                    url={blogPost.url}
                    ctatext={blogPost.ctatext}
                />
            }
            
            <div class="text-center">
                <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white">
                    <span class="sr-only">Welcome to the website of </span>
                    {title.split(' ')[0]} <span class="text-orange-600 dark:text-orange-500">{title.split(' ')[1]}</span>
                </h1>
                <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-white">{subtitle}</p>
                
                <div class="mt-10 flex items-center justify-center gap-x-6">
                    <a 
                        href={calendly} 
                        class="rounded-md bg-primary-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600" 
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Schedule a call with AJ Dichmann">
                        Schedule Call
                    </a>
                    <a 
                        href="/about" 
                        class="text-sm font-semibold leading-6 text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400">
                        About Me<span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Bottom decorative element -->
        <div class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]" aria-hidden="true">
            <div class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-primary-800 to-primary-600 opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" />
        </div>
    </div>
</section>