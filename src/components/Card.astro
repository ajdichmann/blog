---
import { Image } from "astro:assets";
import Link from "./Link.astro";
import { useTranslations } from "@/i18n";

const t = useTranslations();

interface Props {
  title: string;
  description: string;
  imgSrc?: string;
  href?: string;
}

const { title, description, imgSrc, href } = Astro.props;
---

<article class="md max-w-[544px] p-4 md:w-1/2">
  <div
    class:list={["overflow-hidden rounded-md border-2 border-gray-200 border-opacity-60 dark:border-gray-700", 
      { "h-full": imgSrc }]}
  >
    {imgSrc && (
      <div class="aspect-video">
        {href ? (
          <Link href={href} aria-label={t('components.card.linkToPost', {title})}>
            <Image
              alt={title}
              src={imgSrc}
              class="object-cover object-center w-full h-full"
              width={544}
              height={306}
            />
          </Link>
        ) : (
          <Image
            alt={title}
            src={imgSrc}
            class="object-cover object-center w-full h-full"
            width={544}
            height={306}
          />
        )}
      </div>
    )}
    <div class="p-6">
      <h2 class="mb-3 text-2xl font-bold leading-8 tracking-tight">
        {
          href ? (
            <Link href={href} aria-label={t('components.card.linkToPost', {title})}>
              {title}
            </Link>
          ) : (
            title
          )
        }
      </h2>
      <p class="prose mb-3 max-w-none text-gray-500 dark:text-gray-400">
        {description}
      </p>
      {href && (
        <Link
          href={href}
          class="text-base font-medium leading-6 text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          aria-label={t('components.card.linkToPost', {title})}
        >
          {t('components.card.learnMore')} &rarr;
        </Link>
      )}
    </div>
  </div>
</article>
