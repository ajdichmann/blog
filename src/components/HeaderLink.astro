---
import type { HTMLAttributes } from 'astro/types';

// Be more specific with the type
type Props = HTMLAttributes<'a'> & {
  href: string;  // Make href required
};

const { href, class: className, ...props } = Astro.props;

// More robust active state checking
const { pathname } = Astro.url;
const isActive = href === pathname || 
  href === pathname.replace(/\/$/, '') ||
  (href !== '/' && pathname.startsWith(href));

// Add trailing slash to internal links that don't have one
const processedHref = !href.startsWith('http') && !href.startsWith('#') && !href.endsWith('/') 
  ? `${href}/` 
  : href;
---

<a 
  href={processedHref} 
  class:list={[className, { active: isActive }]} 
  aria-current={isActive ? 'page' : undefined}
  {...props}
>
  <slot />
</a>
