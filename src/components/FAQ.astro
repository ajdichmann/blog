---
type FAQ = {
  question: string;
  answer: string;
};

interface Props {
  faqs: FAQ[];
  class?: string;
  title?: string;
}

const { faqs, class: className, title = 'Frequently asked questions' } = Astro.props;
import DetailsSummary from './DetailsSummary.astro';
---

<div class:list={className} class="divide-y divide-gray-200 dark:divide-gray-700 mt-12">
  <h2 class="text-3xl font-bold mb-6">{title}</h2>
  {faqs.map((faq, idx) => (
    <DetailsSummary title={faq.question} class="faq-item">
      <div class="text-gray-600 dark:text-gray-300 mt-2">{faq.answer}</div>
    </DetailsSummary>
  ))}
</div>

<style>
.faq-item summary {
  font-weight: 600;
  font-size: 1.125rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  padding: 1rem 0;
  border: none;
  background: none;
}
.faq-item[open] summary::after {
  content: "\2212"; /* minus sign */
  font-size: 1.5rem;
  margin-left: auto;
}
.faq-item summary::after {
  content: "\002B"; /* plus sign */
  font-size: 1.5rem;
  margin-left: auto;
}
</style> 