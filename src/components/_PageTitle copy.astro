---
interface Props {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<h1 
  {...props} 
  class:list={[
    "text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-5xl md:leading-14",
    className
  ]}
>
  <slot />
</h1>
