---
interface Props {
  blogTitle: string;
  url: string;
  ctatext: string;
  className?: string;
  blogTitleEdit?: Record<string, string>;
  ctatextEdit?: Record<string, string>;
}

const { blogTitle, url, ctatext, className = "", blogTitleEdit, ctatextEdit } = Astro.props;
---

<div class="hidden sm:mb-8 sm:flex sm:justify-center">
  <a 
    href={url}
    class={`relative rounded-full px-3 py-1 text-sm leading-6 text-gray-600 ring-1 ring-inset ring-gray-900/10
    dark:text-gray-400 dark:ring-primary-600/10 ${className}`}
    role="alert"
  >
    <span {...blogTitleEdit}>{blogTitle}</span>{" "}
    <span class="font-semibold text-primary-600 dark:text-primary-400 italic inline-flex items-center">
      <span {...ctatextEdit}>{ctatext}</span>
      <span class="ml-1" aria-hidden="true">&rarr;</span>
    </span>
  </a>
</div>
